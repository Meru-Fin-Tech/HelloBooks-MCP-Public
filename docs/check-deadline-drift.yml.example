# SCHEDULED compliance-deadline drift check (quarterly).
#
# `scripts/check-deadline-drift.ts` fetches each statutory authority page named
# in src/data/complianceDeadlines.ts and flags any catalog date that no longer
# appears on the source — a strong (not certain) signal the authority moved a
# filing date. It writes drift-report.md and exits non-zero on any finding.
#
# This is NETWORK-dependent and intentionally NOT part of the blocking build
# (Jenkinsfile) — it runs on a schedule and opens an issue so a human can review
# each finding against the authority page before editing the catalog. Stale
# statutory dates are the single biggest credibility risk in an agent's answer,
# so this job is the safety net that catches them between manual reviews.
#
# Install (a human with `workflow` scope must do this — the Claude Code OAuth
# token cannot write under .github/workflows/):
#   mkdir -p .github/workflows
#   git mv docs/check-deadline-drift.yml.example \
#          .github/workflows/check-deadline-drift.yml
#   git commit -m "ci: install quarterly deadline-drift check"
#   git push
#
# NOTE: org-wide GitHub Actions billing must be active for scheduled runs to
# fire. The companion Jenkins job (quarterly) can run the same npm script if
# Actions is unavailable.

name: check-deadline-drift

on:
  schedule:
    # 06:12 UTC on the 1st of Jan/Apr/Jul/Oct — quarterly, after most fiscal
    # calendars publish the new year's dates.
    - cron: '12 6 1 1,4,7,10 *'
  workflow_dispatch: {}

permissions:
  contents: read
  issues: write

jobs:
  deadline-drift:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20
          cache: npm

      - run: npm ci --no-audit --no-fund

      # Exits non-zero on drift; `|| true` lets us capture the report and open
      # an issue instead of just failing the run silently.
      - name: Run deadline-drift check
        id: drift
        run: |
          set +e
          npm run check:deadline-drift
          echo "exit_code=$?" >> "$GITHUB_OUTPUT"
          set -e

      - name: Upload drift report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: drift-report
          path: drift-report.md
          if-no-files-found: ignore

      - name: Open an issue on drift
        if: steps.drift.outputs.exit_code != '0'
        uses: actions/github-script@v7
        with:
          script: |
            const fs = require('fs');
            let body = 'The quarterly deadline-drift check reported findings. Review each against the authority `source` page before editing `src/data/complianceDeadlines.ts`.';
            try {
              const report = fs.readFileSync('drift-report.md', 'utf8');
              body += '\n\n<details><summary>drift-report.md</summary>\n\n' + report + '\n\n</details>';
            } catch {}
            await github.rest.issues.create({
              owner: context.repo.owner,
              repo: context.repo.repo,
              title: `Compliance deadline drift detected (${new Date().toISOString().slice(0,10)})`,
              labels: ['compliance', 'data-freshness'],
              body,
            });
