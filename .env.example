# HelloBooks Public MCP Server — environment variables
#
# This is a public, read-only MCP server: NO database, NO customer data. The
# only sensitive value is the optional GA4 analytics API secret below — keep
# a real one out of git. Copy this file to `.env` to override defaults for
# local development; in production (Docker) the transport defaults are baked
# into the image and the GA4 vars are injected by the Jenkins deploy job.

# --- Transport -------------------------------------------------------------

# HTTP listener port. The Docker image exposes 8080.
PORT=8080

# HTTP listener host. 0.0.0.0 binds all interfaces — required behind a
# load balancer. Use 127.0.0.1 for loopback-only local dev.
HOST=0.0.0.0

# Node runtime mode. Production strips dev tooling and disables verbose errors.
NODE_ENV=production

# --- Analytics (optional) --------------------------------------------------
#
# Layer-2 server-side usage telemetry: anonymous session / tool-call counts
# sent to GA4 via the Measurement Protocol. See src/analytics.ts and the
# strategy doc (marketing-strategy → strategy/73-MCP-Analytics-Attribution-
# Strategy.md).
#
# BOTH variables must be set for telemetry to activate. Leave EITHER blank —
# the default — and the server runs with analytics fully disabled: no
# outbound calls, no new required config.
#
# GA4_API_SECRET is a write-only Measurement Protocol secret (it cannot read
# analytics data back) but it is still a secret — never commit a real value.

# GA4 Data Stream Measurement ID, e.g. G-XXXXXXXXXX
GA4_MEASUREMENT_ID=

# GA4 Measurement Protocol API secret
# (GA4 Admin -> Data Streams -> Measurement Protocol API secrets).
GA4_API_SECRET=

# --- Analytics reporting / read (optional) ---------------------------------
#
# Layer-2 READ support: query the mcp_* event counts back out of GA4 via the
# GA4 Data API. This is entirely separate from the write path above — it uses a
# read-scoped *service account*, never the Measurement Protocol secret, and it
# never emits events. See src/reporting/ and docs/MCP_ANALYTICS_REPORTING.md.
#
# Fully OPTIONAL and DISABLED unless ALL THREE of the vars below are set. With
# them unset (the default) the reporting CLI is inert and the HTTP endpoint
# does not exist. No reporting var is ever required to run the server.
#
# These are credentials — never commit real values.

# Numeric GA4 property id (GA4 Admin -> Property Settings), e.g. 123456789.
# This is the property *number*, NOT the G-XXXXXXXXXX measurement id above.
GA4_PROPERTY_ID=

# Service-account email with "Viewer" access to the GA4 property
# (GA4 Admin -> Property Access Management).
GA4_SA_CLIENT_EMAIL=

# Service-account PEM private key. Paste the full key; literal "\n" escapes are
# accepted (and converted to real newlines), so a single-line value works:
# GA4_SA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GA4_SA_PRIVATE_KEY=

# Bearer token guarding the HTTP reporting endpoint (/internal/analytics).
# Set this IN ADDITION to the three vars above to expose the endpoint; leave it
# blank to keep the endpoint disabled while still allowing the CLI report.
# Use a long random value, e.g. `openssl rand -hex 32`.
GA4_REPORTING_TOKEN=
